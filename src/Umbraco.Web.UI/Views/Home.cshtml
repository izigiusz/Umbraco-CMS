@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var blog = Model.ChildrenOfType(BlogAliases.Blog).FirstOrDefault();
    var posts = blog?
        .ChildrenOfType(BlogAliases.Post)
        .OrderByDescending(post => post.Value<DateTime?>(BlogAliases.PublishDate) ?? post.CreateDate)
        .Take(3)
        .ToList() ?? [];
}
<h1>@Model.Name</h1>
@if (Model.HasValue(BlogAliases.Intro))
{
    <p class="lead">@Model.Value(BlogAliases.Intro)</p>
}
@if (posts.Count == 0)
{
    <p>No posts yet.</p>
}
else
{
    <ul class="post-list">
        @foreach (var post in posts)
        {
            <li>@await Html.PartialAsync("~/Views/Partials/Blog/PostCard.cshtml", post)</li>
        }
    </ul>
    @if (blog is not null)
    {
        <p><a href="@blog.Url()">All posts</a></p>
    }
}
