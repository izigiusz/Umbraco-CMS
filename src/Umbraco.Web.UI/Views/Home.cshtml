@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var blog = Model.ChildrenOfType(BlogAliases.Blog).FirstOrDefault();
    var posts = new List<IPublishedContent>();
    var categories = new List<IPublishedContent>();
    IReadOnlyList<IPublishedContent> featuredPosts = [];
    try
    {
        posts = blog?
            .ChildrenOfType(BlogAliases.Post)
            .OrderByDescending(BlogList.PublishDate)
            .Take(3)
            .ToList() ?? [];
        categories = Portal.Categories(Model).ToList();
        featuredPosts = BlogList.FeaturedPosts(Model);
    }
    catch
    {
        posts = [];
        categories = [];
        featuredPosts = [];
    }
}
<section class="hero">
    <p class="eyebrow">@SiteText.Get(Umbraco, SiteText.HomeEyebrow)</p>
    <h1>Codation</h1>
    <p class="tagline">@SiteText.Get(Umbraco, SiteText.HomeTagline)</p>
    <p class="mission">AI SDLC | Harness Engineering | Software Factory</p>
</section>
@if (Model.HasValue(BlogAliases.Intro))
{
    <p class="note">@Model.Value(BlogAliases.Intro)</p>
}
<section class="section" aria-label="@SiteText.Get(Umbraco, SiteText.HomeLatest)">
    <h2>@SiteText.Get(Umbraco, SiteText.HomeLatest)</h2>
    @if (posts.Count == 0)
    {
        <p>@SiteText.Get(Umbraco, SiteText.HomeEmpty)</p>
    }
    else
    {
        <ul class="post-list">
            @foreach (var post in posts)
            {
                <li>
                    @try
                    {
                        @await Html.PartialAsync("~/Views/Partials/Blog/PostCard.cshtml", post)
                    }
                    catch
                    {
                        <p class="meta">@SiteText.Get(Umbraco, SiteText.HomePostFailed)</p>
                    }
                </li>
            }
        </ul>
    }
    @if (blog is not null)
    {
        <p><a href="@blog.Url()">@SiteText.Get(Umbraco, SiteText.HomeAllNews)</a></p>
    }
</section>
@if (featuredPosts.Count > 0)
{
    <section class="section featured" aria-label="@SiteText.Get(Umbraco, SiteText.HomeFeatured)">
        <h2>@SiteText.Get(Umbraco, SiteText.HomeFeatured)</h2>
        <ul class="featured-grid">
            @foreach (var featuredPost in featuredPosts)
            {
                <li>
                    @try
                    {
                        @await Html.PartialAsync("~/Views/Partials/Blog/FeaturedTopic.cshtml", featuredPost)
                    }
                    catch
                    {
                        <p class="meta">@SiteText.Get(Umbraco, SiteText.HomeItemFailed)</p>
                    }
                </li>
            }
        </ul>
    </section>
}
@if (categories.Count > 0)
{
    <section class="section" aria-label="@SiteText.Get(Umbraco, SiteText.HomeCategories)">
        <h2>@SiteText.Get(Umbraco, SiteText.HomeCategories)</h2>
        <ul class="cat-strip">
            @foreach (var category in categories)
            {
                <li>@await Html.PartialAsync("~/Views/Partials/Blog/CategoryChip.cshtml", category)</li>
            }
        </ul>
    </section>
}
