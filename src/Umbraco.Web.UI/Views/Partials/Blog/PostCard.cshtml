@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var published = Model.Value<DateTime?>(BlogAliases.PublishDate) ?? Model.CreateDate;
}
<a class="post-card" href="@Model.Url()">
    <div class="meta">@published.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</div>
    <h2>@Model.Name</h2>
    @if (Model.HasValue(BlogAliases.Summary))
    {
        <p>@Model.Value(BlogAliases.Summary)</p>
    }
</a>
