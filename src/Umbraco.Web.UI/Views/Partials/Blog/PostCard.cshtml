@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@try
{
    var published = BlogList.PublishDate(Model);
    var href = Model.Url() ?? "#";
    var category = BlogList.PickedCategory(Model);
    var lead = BlogList.Summary(Model);
    <a class="post-card" href="@href">
        <div class="meta">@Portal.FormatDate(published)</div>
        @if (category is not null)
        {
            <span class="chip" style="--chip: @Portal.AccentCss(category)">@Portal.CategoryName(category)</span>
        }
        <h2>@(string.IsNullOrWhiteSpace(Model.Name) ? "Bez tytułu" : Model.Name)</h2>
        @if (string.IsNullOrWhiteSpace(lead) is false)
        {
            <p>@lead</p>
        }
    </a>
}
catch
{
    <p class="meta">Nie udało się wyświetlić wpisu.</p>
}
