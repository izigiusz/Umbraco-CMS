@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var home = Model.Root();
    var blog = home?.ChildrenOfType("blog").FirstOrDefault();
    var siteName = home?.Name ?? "Blog";
    var pageTitle = home is not null && Model.Id == home.Id ? siteName : $"{Model.Name} — {siteName}";
    var description = ViewData["Description"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    @if (!string.IsNullOrWhiteSpace(description))
    {
        <meta name="description" content="@description" />
    }
    <link rel="icon" href="/favicon.ico" />
    <style>
        :root {
            color-scheme: light;
            --ink: #1c1917;
            --muted: #57534e;
            --line: #e7e5e4;
            --paper: #faf7f2;
            --card: #fffdf8;
            --accent: #9a3412;
            --accent-soft: #ffedd5;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Segoe UI", system-ui, sans-serif;
            color: var(--ink);
            background: var(--paper);
            line-height: 1.6;
        }
        a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
        a:hover { text-decoration-thickness: 2px; }
        .site-header, .site-footer, .wrap { width: min(42rem, calc(100% - 2rem)); margin-inline: auto; }
        .site-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 1rem;
            padding: 1.25rem 0 0.75rem;
            border-bottom: 1px solid var(--line);
        }
        .brand { color: inherit; font-weight: 650; text-decoration: none; letter-spacing: -0.02em; }
        .site-nav { display: flex; gap: 1rem; }
        .site-nav a { color: var(--muted); text-decoration: none; }
        .site-nav a[aria-current="page"] { color: var(--ink); }
        main { padding: 1.75rem 0 3rem; }
        h1, h2 { font-family: Georgia, "Iowan Old Style", Palatino, serif; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; }
        h1 { font-size: clamp(2rem, 5vw, 2.75rem); margin: 0 0 0.75rem; }
        .lead { color: var(--muted); font-size: 1.125rem; margin-top: 0; }
        .post-list { list-style: none; padding: 0; margin: 2rem 0 0; }
        .post-list > li { border-top: 1px solid var(--line); }
        .post-card { display: block; padding: 1.1rem 0; color: inherit; text-decoration: none; }
        .post-card h2 { margin: 0.2rem 0; font-size: 1.4rem; }
        .meta { color: var(--muted); font-size: 0.875rem; }
        .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.75rem 0; padding: 0; list-style: none; }
        .tags a, .tag {
            background: var(--accent-soft);
            color: var(--accent);
            border-radius: 999px;
            padding: 0.1rem 0.65rem;
            font-size: 0.8125rem;
            text-decoration: none;
        }
        .cover { width: 100%; height: auto; border-radius: 0.5rem; margin: 0.5rem 0 1rem; background: var(--card); }
        .body { font-size: 1.05rem; }
        .body img { max-width: 100%; height: auto; }
        .pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; }
        .featured { margin-top: 2.75rem; }
        .featured h2 { font-size: 1.6rem; margin: 0 0 0.85rem; }
        .featured-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.75rem; }
        .featured-card { display: flex; flex-direction: column; height: 100%; padding: 1rem; background: var(--card); border: 1px solid var(--line); border-radius: 0.6rem; color: inherit; text-decoration: none; }
        .featured-card h3 { margin: 0.25rem 0 0.4rem; font-size: 1.2rem; font-family: Georgia, "Iowan Old Style", Palatino, serif; font-weight: 500; }
        .featured-card p { margin: 0 0 0.75rem; }
        .site-footer { color: var(--muted); font-size: 0.875rem; padding: 1rem 0 2rem; border-top: 1px solid var(--line); }
        @@media (max-width: 640px) {
            .site-header { align-items: flex-start; flex-direction: column; gap: 0.35rem; }
            h1 { font-size: 1.85rem; }
        }
    </style>
</head>
<body>
    <header class="site-header">
        <a class="brand" href="@(home?.Url() ?? "/")">@siteName</a>
        <nav class="site-nav" aria-label="Site">
            @if (home is not null)
            {
                <a href="@home.Url()" aria-current="@(Model.Id == home.Id ? "page" : null)">Home</a>
            }
            @if (blog is not null)
            {
                <a href="@blog.Url()" aria-current="@(Model.Id == blog.Id || Model.ContentType.Alias == "blogPost" ? "page" : null)">Blog</a>
            }
        </nav>
    </header>
    <main class="wrap">
        @RenderBody()
    </main>
    <footer class="site-footer wrap">
        <p>@siteName</p>
    </footer>
</body>
</html>
