@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var title = Model.Name;
    var lead = string.Empty;
    var related = new List<IPublishedContent>();
    var posts = new List<IPublishedContent>();
    try
    {
        title = Portal.PillarTitle(Model);
        lead = Portal.Lead(Model) ?? string.Empty;
        related = Portal.RelatedCategories(Model).ToList();
        posts = Portal.PostsForPillar(Model).ToList();
        ViewData["Description"] = string.IsNullOrWhiteSpace(lead) ? null : lead;
    }
    catch
    {
        title = Model.Name;
    }
}
<p class="eyebrow">@SiteText.Get(Umbraco, SiteText.PillarEyebrow)</p>
<h1>@title</h1>
@if (!string.IsNullOrWhiteSpace(lead))
{
    <p class="lead">@lead</p>
}
<div class="body">
    @try
    {
        @Model.Value(BlogAliases.Body)
    }
    catch
    {
        <p class="meta">@SiteText.Get(Umbraco, SiteText.PillarUnavailable)</p>
    }
</div>
@if (related.Count > 0)
{
    <section class="section" aria-label="@SiteText.Get(Umbraco, SiteText.PillarRelated)">
        <h2>@SiteText.Get(Umbraco, SiteText.PillarRelated)</h2>
        <ul class="cat-strip">
            @foreach (var category in related)
            {
                <li>@await Html.PartialAsync("~/Views/Partials/Blog/CategoryChip.cshtml", category)</li>
            }
        </ul>
    </section>
}
@if (posts.Count > 0)
{
    <section class="section" aria-label="@SiteText.Get(Umbraco, SiteText.HomeLatest)">
        <h2>@SiteText.Get(Umbraco, SiteText.HomeLatest)</h2>
        <ul class="post-list">
            @foreach (var post in posts)
            {
                <li>
                    @try
                    {
                        @await Html.PartialAsync("~/Views/Partials/Blog/PostCard.cshtml", post)
                    }
                    catch
                    {
                        <p class="meta">@SiteText.Get(Umbraco, SiteText.HomePostFailed)</p>
                    }
                </li>
            }
        </ul>
    </section>
}
