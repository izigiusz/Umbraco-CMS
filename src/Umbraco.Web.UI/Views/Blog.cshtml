@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    const int pageSize = 6;
    var tagFilter = Context.Request.Query["tag"].ToString();
    var categoryFilter = Context.Request.Query["category"].ToString();
    var categoryTitle = categoryFilter;
    var blogUrl = SiteText.IsEnglish ? "/en/news/" : "/aktualnosci/";
    var posts = new List<IPublishedContent>();
    try
    {
        blogUrl = Model.Url() ?? blogUrl;
        IEnumerable<IPublishedContent> query = Model.ChildrenOfType(BlogAliases.Post) ?? Enumerable.Empty<IPublishedContent>();
        if (!string.IsNullOrWhiteSpace(tagFilter))
        {
            query = query.Where(post => BlogList.HasTag(post, tagFilter));
        }

        if (!string.IsNullOrWhiteSpace(categoryFilter))
        {
            query = query.Where(post => BlogList.MatchesCategory(post, categoryFilter));
            categoryTitle = BlogList.CategoryTitle(Model, categoryFilter) ?? categoryFilter;
        }

        posts = query.OrderByDescending(BlogList.PublishDate).ToList();
    }
    catch
    {
        posts = new List<IPublishedContent>();
    }

    var totalPages = posts.Count == 0 ? 1 : (int)Math.Ceiling(posts.Count / (double)pageSize);
    var pageNumber = BlogList.ParsePage(Context.Request.Query["page"].ToString(), totalPages);
    var pagePosts = posts.Skip((pageNumber - 1) * pageSize).Take(pageSize);
}
<h1>@Model.Name</h1>
@if (Model.HasValue(BlogAliases.Intro))
{
    <p class="lead">@Model.Value(BlogAliases.Intro)</p>
}
@if (!string.IsNullOrWhiteSpace(tagFilter) || !string.IsNullOrWhiteSpace(categoryFilter))
{
    <p class="meta">
        @if (!string.IsNullOrWhiteSpace(categoryFilter))
        {
            <span>@SiteText.Get(Umbraco, SiteText.BlogCategory) @categoryTitle. </span>
        }
        @if (!string.IsNullOrWhiteSpace(tagFilter))
        {
            <span>@SiteText.Get(Umbraco, SiteText.BlogTag) @tagFilter. </span>
        }
        <a href="@blogUrl">@SiteText.Get(Umbraco, SiteText.ToolsShowAll)</a>
    </p>
}
@if (!pagePosts.Any())
{
    <p>@SiteText.Get(Umbraco, SiteText.BlogEmpty)</p>
}
else
{
    <ul class="post-list">
        @foreach (var post in pagePosts)
        {
            <li>
                @try
                {
                    @await Html.PartialAsync("~/Views/Partials/Blog/PostCard.cshtml", post)
                }
                catch
                {
                    <p class="meta">@SiteText.Get(Umbraco, SiteText.HomePostFailed)</p>
                }
            </li>
        }
    </ul>
}
@if (totalPages > 1)
{
    <nav class="pager" aria-label="@SiteText.Get(Umbraco, SiteText.BlogPager)">
        @if (pageNumber > 1)
        {
            <a href="@BlogList.PageUrl(blogUrl, tagFilter, pageNumber - 1, categoryFilter)">@SiteText.Get(Umbraco, SiteText.BlogNewer)</a>
        }
        else
        {
            <span></span>
        }
        <span class="meta">@(pageNumber) / @totalPages</span>
        @if (pageNumber < totalPages)
        {
            <a href="@BlogList.PageUrl(blogUrl, tagFilter, pageNumber + 1, categoryFilter)">@SiteText.Get(Umbraco, SiteText.BlogOlder)</a>
        }
    </nav>
}
