@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var name = Model.Name;
    var description = string.Empty;
    var accent = "#22d3ee";
    var posts = new List<IPublishedContent>();
    try
    {
        name = Portal.CategoryName(Model);
        description = Portal.TextOrEmpty(Model, BlogAliases.Description);
        accent = Portal.AccentCss(Model);
        posts = Portal.PostsInCategory(Model).ToList();
        if (string.IsNullOrWhiteSpace(description) is false)
        {
            ViewData["Description"] = description;
        }
    }
    catch
    {
        name = Model.Name;
    }
}
<p><span class="chip" style="--chip: @accent">@name</span></p>
<h1>@name</h1>
@if (!string.IsNullOrWhiteSpace(description))
{
    <p class="lead">@description</p>
}
<section class="section" aria-label="Wpisy">
    <h2>Wpisy</h2>
    @if (posts.Count == 0)
    {
        <p>Brak wpisów w tej kategorii.</p>
    }
    else
    {
        <ul class="post-list">
            @foreach (var post in posts)
            {
                <li>
                    @try
                    {
                        @await Html.PartialAsync("~/Views/Partials/Blog/PostCard.cshtml", post)
                    }
                    catch
                    {
                        <p class="meta">Nie udało się wyświetlić wpisu.</p>
                    }
                </li>
            }
        </ul>
    }
</section>
