@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var name = Model.Name;
    var description = string.Empty;
    var accent = "#22d3ee";
    var posts = new List<IPublishedContent>();
    var tools = new List<IPublishedContent>();
    try
    {
        name = Portal.CategoryName(Model);
        description = Portal.TextOrEmpty(Model, BlogAliases.Description);
        accent = Portal.AccentCss(Model);
        posts = Portal.PostsInCategory(Model).ToList();
        if (string.IsNullOrWhiteSpace(description) is false)
        {
            ViewData["Description"] = description;
        }
    }
    catch
    {
        name = Model.Name;
    }

    try
    {
        tools = Portal.ToolsInCategory(Model).ToList();
    }
    catch
    {
        tools = [];
    }
}
<p><span class="chip" style="--chip: @accent">@name</span></p>
<h1>@name</h1>
@if (!string.IsNullOrWhiteSpace(description))
{
    <p class="lead">@description</p>
}
<section class="section" aria-label="@SiteText.Get(Umbraco, SiteText.CategoryPosts)">
    <h2>@SiteText.Get(Umbraco, SiteText.CategoryPosts)</h2>
    @if (posts.Count == 0)
    {
        <p>@SiteText.Get(Umbraco, SiteText.CategoryEmpty)</p>
    }
    else
    {
        <ul class="post-list">
            @foreach (var post in posts)
            {
                <li>
                    @try
                    {
                        @await Html.PartialAsync("~/Views/Partials/Blog/PostCard.cshtml", post)
                    }
                    catch
                    {
                        <p class="meta">@SiteText.Get(Umbraco, SiteText.HomePostFailed)</p>
                    }
                </li>
            }
        </ul>
    }
</section>
@if (tools.Count > 0)
{
    <section class="section" aria-label="@SiteText.Get(Umbraco, SiteText.CategoryTools)">
        <h2>@SiteText.Get(Umbraco, SiteText.CategoryTools)</h2>
        <ul class="post-list">
            @foreach (var tool in tools)
            {
                <li>
                    @try
                    {
                        @await Html.PartialAsync("~/Views/Partials/Blog/ToolCard.cshtml", tool)
                    }
                    catch
                    {
                        <p class="meta">@SiteText.Get(Umbraco, SiteText.ToolsFailed)</p>
                    }
                </li>
            }
        </ul>
    </section>
}
